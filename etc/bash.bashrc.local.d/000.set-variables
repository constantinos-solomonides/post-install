function mpushd(){
    [ ${#*} == 1 ] || { echo "Must provide a path to create" 1>&2; return 1; }
    mkdir -p "${1}" || { echo "Couldn't create the directory" 1>&2; return 1; }
    pushd "${1}"

}

function pushd(){
    builtin pushd $@ || {
        [ ${#*} == 1 ] || {
            echo "Must provide only a single path" 1>&2; return 1;
        };
        read -p "The path $@ does not exist. Do you wish to create it? [y/N]";
            [[ ${REPLY,,} =~ ye?s? ]] \
        &&  mkdir -p ${@} \
        && builtin pushd $@
    }
}

