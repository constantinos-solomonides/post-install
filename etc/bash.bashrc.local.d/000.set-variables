function check_in_screen(){
    pid="$$";
    if [ -z "${pid}" ]; then
        return 1
    fi
    for i in {1..15}; do
        [ "${pid}" -eq 1 ] && return 1
        ps -h -p "${pid}" -o cmd | grep -q -e SCREEN && return 0
        pid=$(ps -p "${pid}" -h -o ppid | sed -e 's/\s*//')
    done
    return 1
}

[ -z "$TMOUT" ] && {
    (! check_in_screen) && {
        TMOUT=900;
        export TMOUT;
    }
} #/set TMOUT if not set

