#!/bin/bash
#set -x
count=10;
pid=$$;
while ((pid != 1)); do
    [ -z "${pid// }" ] && break
    if ( ps -o comm -h -p "${pid// }" | grep -q -e 'screen' ; ); then
        _title=$(screen -Q title)
        if [[ ${_title} =~ ^bash$ ]]; then
            screen -X title CLI;
        fi
        break;
    elif (( count-- == 0)); then
        break;
    else
        pid=$(ps -o ppid -h -p "${pid// }");
    fi;
done
#set +x
