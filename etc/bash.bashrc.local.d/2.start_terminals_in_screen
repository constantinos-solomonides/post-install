#!/bin/bash
# Start terminals in screen mode.
session_name_file="${HOME}/default_session_name"
SENTINEL_ONE="/tmp/no_screen"
SENTINEL_TWO="${HOME}/no_screen"
SESSION_DEFAULT_NAME="GENERIC"

function get_screen_session_name(){
    # If the variable $SCREEN_SESSION_NAME is not empty, that's the name
    [ ! -z "${SCREEN_SESSION_NAME}" ] && { echo "${SCREEN_SESSION_NAME}" && return; }

    # If the file ${session_name_file} is not empty, that's the name
    _name=$([ -e "${session_name_file}" ] && echo $(<${session_name_file});)
    [ ! -z "${_name}" ] && { echo "${_name}" && return; }

    echo "${SESSION_DEFAULT_NAME}";
}

function sentinels_exist(){
    [ -e "${SENTINEL_ONE}" ] && {
        rm -f "${SENTINEL_ONE}"; true;
    } || [ -e "${SENTINEL_TWO}" ] && {
        rm -f "${SENTINEL_TWO}"; true;
    }
}

function get_next_screen_session_name(){
    _base=$(get_screen_session_name)
    _count=$( screen -ls | grep -c ${_base})
    printf "%02d-%s" $((_count + 1)) ${_base}

}

SCREEN_SESSION_NAME=$( get_screen_session_name )

[ "true" == "${SCREEN_SESSION_ACTIVE}" ] || {
    # Set `SCREEN_SESSION_ACTIVE` to to and export it to ensure there's no duplicate sub-screen sessiosn starting
    SCREEN_SESSION_ACTIVE="true"; readonly SCREEN_SESSION_ACTIVE; export SCREEN_SESSION_ACTIVE;
    sentinels_exist || { # Start a screen session
        { # Try re-connecting to the default screen session, and if not possible, create a new with the default name
            screen -r ${SCREEN_SESSION_NAME} 2>/dev/null || screen -R $(get_next_screen_session_name);
        } && { # This takes place after the screen was run successfuly (after the last process exits
            sentinels_exist || { sleep 1s; exit; }
        }
    }
}

